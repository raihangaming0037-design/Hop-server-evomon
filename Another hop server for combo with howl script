-- PENGATURAN AWAL
local WAKTU_TUNGGU_GAME = 10 -- Dikurangi jadi 10 detik agar cepat terlihat di console
local TIME_TO_HOP = 20        -- Detik idle sebelum pindah server

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer
local idleCounter = 0

-- Log Instan untuk penanda bahwa script masuk
print("[AUTO-HOP] Script berhasil masuk ke executor! Menghitung mundur sebelum aktif...")

for i = WAKTU_TUNGGU_GAME, 1, -1 do
    print("[AUTO-HOP] Memulai dalam: " .. i .. " detik...")
    task.wait(1)
end

print("[AUTO-HOP] SCRIPT AKTIF! Mulai memantau status karakter...")

local function isPlayerFighting()
    local success, fighting = pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return false end
        
        local sceneUI = playerGui:FindFirstChild("SceneUIRoot")
        if sceneUI then
            local billboardRoot = sceneUI:FindFirstChild("BillboardUIRoot")
            if billboardRoot then
                for _, window in pairs(billboardRoot:GetChildren()) do
                    if window.Name == "HeadDisplayBillboardWindow" then
                        local nameDisplay = window:FindFirstChild("PlayerNameDisplay")
                        if nameDisplay and nameDisplay:FindFirstChild("ContentFrame") and nameDisplay.ContentFrame:FindFirstChild("PlayerNameText") then
                            if nameDisplay.ContentFrame.PlayerNameText.Text == LocalPlayer.Name then
                                local inFightFrame = window:FindFirstChild("PlayerInFightFrame")
                                if inFightFrame and inFightFrame.Visible then
                                    local contentFrame = inFightFrame:FindFirstChild("ContentFrame")
                                    if contentFrame then
                                        local fightingText = contentFrame:FindFirstChild("Fighting")
                                        if fightingText and fightingText.Visible and fightingText.Text ~= "" and string.find(fightingText.Text, "Fighting") then
                                            return true
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        return false
    end)
    if success then return fighting else return false end
end

local function forceHop()
    print("[AUTO-HOP] TRIGGERED! Memaksa pemindahan server sekarang...")
    local placeId = game.PlaceId
    
    -- Menggunakan TeleportAsync bawaan engine Roblox
    local tOpts = Instance.new("TeleportOptions")
    tOpts.ShouldReserveServer = false
    
    local success = pcall(function()
        TeleportService:TeleportAsync(placeId, {LocalPlayer}, tOpts)
    end)
    
    if not success then
        print("[AUTO-HOP] Metode Async gagal/diblokir, beralih ke Metode Regular...")
        pcall(function()
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end
end

-- Menjalankan loop di thread terpisah agar tidak terganggu error script lain
task.spawn(function()
    while true do
        task.wait(1)
        if isPlayerFighting() then
            if idleCounter > 0 then
                print("[AUTO-HOP] Karakter bertarung. Reset hitungan idle.")
                idleCounter = 0
            end
        else
            idleCounter = idleCounter + 1
            -- Print status setiap 5 detik agar console tidak terlalu penuh tapi tetap terpantau
            if idleCounter % 5 == 0 or idleCounter == 1 then
                print("[AUTO-HOP] Status: IDLE (" .. idleCounter .. "/" .. TIME_TO_HOP .. " detik)")
            end
            
            if idleCounter >= TIME_TO_HOP then
                idleCounter = 0
                forceHop()
                task.wait(5)
            end
        end
    end
end)
